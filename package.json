    "migrate:rollback": "sequelize-cli db:migrate:undo --config lib/database/config/config.cjs --migrations-path lib/database/migrations",
    "migrate:rollback:all": "sequelize-cli db:migrate:undo:all --config lib/database/config/config.cjs --migrations-path lib/database/migrations"
  },
